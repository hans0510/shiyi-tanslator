<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾译 · 划词蓝点" Width="24" Height="24" Left="-32000" Top="-32000"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False">
  <Button x:Name="TranslateSelection" Focusable="False" Cursor="Hand" AutomationProperties.Name="翻译选中文字">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Grid Background="#01000000">
          <Ellipse x:Name="Dot" Width="15" Height="15" Fill="#216EF3" Stroke="White" StrokeThickness="1.5">
            <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0.7" Opacity="0.32"/></Ellipse.Effect>
          </Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Dot" Property="Width" Value="17"/><Setter TargetName="Dot" Property="Height" Value="17"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#154EBB"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Button.Template>
  </Button>
</Window>
