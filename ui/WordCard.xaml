<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,7">
    <DockPanel>
      <Button x:Name="Speak" DockPanel.Dock="Right" Padding="9,4" VerticalAlignment="Center" AutomationProperties.Name="朗读单词">
        <StackPanel Orientation="Horizontal">
          <Path Width="14" Height="13" Margin="0,0,5,0" Stretch="Uniform" Fill="#235ABA" Data="M0,4 L3,4 L7,1 L7,13 L3,10 L0,10 Z M9,3 Q15,7 9,11 L9,9 Q12,7 9,5 Z"/>
          <TextBlock Text="发音"/>
        </StackPanel>
      </Button>
      <TextBlock x:Name="Headword" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0"/>
    </DockPanel>
    <WrapPanel>
      <TextBlock x:Name="Phonetic" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="15" Foreground="#425B73" Margin="0,1,12,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="Lemma" Style="{StaticResource Hint}"/>
    </WrapPanel>
    <TextBlock x:Name="VoiceNote" Visibility="Collapsed" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
  </StackPanel>
  <ScrollViewer x:Name="Details" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,1,6,1">
      <Border x:Name="ContextPanel" Background="#EEF4FF" CornerRadius="5" Padding="9,7" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="句中义" FontSize="12" FontWeight="SemiBold" Foreground="#235ABA"/>
          <TextBlock x:Name="ContextMeaning" FontSize="15" TextWrapping="Wrap" Margin="0,2,0,3"/>
          <TextBlock x:Name="OriginalSentence" Style="{StaticResource Hint}" FontSize="13"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="NoContext" Text="未获取到原句，以下为常见释义。" Style="{StaticResource Hint}" Margin="0,0,0,7"/>
      <TextBlock Text="常见释义" FontWeight="SemiBold" FontSize="13"/>
      <ItemsControl x:Name="Senses" Margin="0,2,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Pos}" Foreground="#235ABA" FontSize="13" Margin="0,1,8,0" MaxWidth="85" TextWrapping="Wrap"/>
              <TextBlock Grid.Column="1" Text="{Binding Meaning}" FontSize="14" TextWrapping="Wrap"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel x:Name="PairsPanel" Margin="0,8,0,0">
        <TextBlock Text="常用搭配" FontWeight="SemiBold" FontSize="13"/>
        <TextBlock x:Name="Pairs" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
      <StackPanel x:Name="ExamplePanel" Margin="0,8,0,0">
        <TextBlock Text="例句" FontWeight="SemiBold" FontSize="13"/>
        <TextBlock x:Name="ExampleSource" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0"/>
        <TextBlock x:Name="ExampleTranslation" Style="{StaticResource Hint}" FontSize="13"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Grid>
