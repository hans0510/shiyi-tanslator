<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾译 · 选区译文" Width="376" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
  <Border CornerRadius="9" BorderBrush="#ADC3E8" BorderThickness="1" Background="White" Padding="15,12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <Button x:Name="Dismiss" DockPanel.Dock="Right" Content="关闭" Padding="7,3"/>
        <Button x:Name="Expand" DockPanel.Dock="Right" Content="主窗口" Padding="7,3" Margin="0,0,6,0"/>
        <TextBlock x:Name="PopupTitle" Style="{StaticResource Section}" Foreground="#235ABA"/>
      </DockPanel>
      <TextBlock Grid.Row="1" x:Name="Excerpt" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource Hint}" Margin="0,10,0,7"/>
      <TextBox Grid.Row="2" x:Name="Result" AutomationProperties.Name="选区译文" Style="{StaticResource Editor}" IsReadOnly="True" IsUndoEnabled="False" MinHeight="36" MaxHeight="210"/>
      <ContentControl Grid.Row="2" x:Name="PopupEntry" Visibility="Collapsed" MaxHeight="400" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,7,0,0"/>
      <DockPanel Grid.Row="3" Margin="0,8,0,0">
        <Button x:Name="Connect" Content="设置模型" Visibility="Collapsed" DockPanel.Dock="Right" Padding="10,4"/>
        <Button x:Name="CopyResult" Content="复制译文" DockPanel.Dock="Right" Padding="10,4"/>
        <TextBlock x:Name="PopupStatus" Style="{StaticResource Hint}" Margin="0,0,8,0"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
