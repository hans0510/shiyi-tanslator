<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾译 · 划词翻译" Width="664" Height="680" MinWidth="460" MinHeight="440" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
  <Grid Margin="24,21,24,15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/>
      <RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="13"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="模型设置" VerticalAlignment="Center"/>
      <Border DockPanel.Dock="Left" Background="{StaticResource Accent}" CornerRadius="11" Width="45" Height="45" Margin="0,0,12,0">
        <TextBlock Text="译" FontSize="25" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="拾译" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="ModelLabel" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="17,13">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="原文" Style="{StaticResource Section}"/><TextBlock Text="自动识别语言" HorizontalAlignment="Right" Style="{StaticResource Hint}"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,9,0,9">
          <TextBox x:Name="Source" AutomationProperties.Name="原文" Style="{StaticResource Editor}" VerticalContentAlignment="Top"/>
          <TextBlock Text="输入或粘贴要翻译的文字…" IsHitTestVisible="False" Margin="2,4" FontSize="15" Foreground="{StaticResource Muted}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=Source}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <DockPanel Grid.Row="2">
          <Button x:Name="TranslateButton" Style="{StaticResource Primary}" Content="翻译" Width="84" DockPanel.Dock="Right" ToolTip="翻译 (Ctrl+Enter)"/>
          <TextBlock x:Name="Count" Style="{StaticResource Hint}"/>
        </DockPanel>
      </Grid>
    </Border>
    <Border Grid.Row="4" Background="#FBFDF9" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="17,13">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel>
          <Button x:Name="CopyButton" Content="复制译文" IsEnabled="False" DockPanel.Dock="Right"/>
          <TextBlock x:Name="ResultTitle" Text="译文" Style="{StaticResource Section}" DockPanel.Dock="Left"/>
          <ComboBox x:Name="Target" AutomationProperties.Name="目标语言" Margin="12,0,0,0" Width="109" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,10,0,0">
          <TextBox x:Name="Output" AutomationProperties.Name="译文" Style="{StaticResource Editor}" IsReadOnly="True" IsUndoEnabled="False"/>
          <ContentControl x:Name="MainEntry" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          <TextBlock x:Name="OutputHint" Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="2,4" FontSize="15" IsHitTestVisible="False"/>
        </Grid>
      </Grid>
    </Border>
    <DockPanel Grid.Row="6">
      <TextBlock x:Name="HotkeyLabel" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource Hint}" Text="Ctrl+Alt+T 划词翻译"/>
      <TextBlock x:Name="Status" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>
