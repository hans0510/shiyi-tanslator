<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾译 · 模型设置" Width="474" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,19,24,21">
      <TextBlock Text="模型设置" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="连接兼容 OpenAI Chat Completions 的模型服务。" Style="{StaticResource Hint}" Margin="0,4,0,15"/>
      <Label Target="{Binding ElementName=Address}" Content="接口地址" Padding="0,0,0,5"/>
      <TextBox x:Name="Address" Style="{StaticResource Field}" AutomationProperties.Name="接口地址"/>
      <TextBlock Text="可填写 Base URL 或完整的 /chat/completions 地址。" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
      <Label Target="{Binding ElementName=ModelName}" Content="模型名称" Padding="0,0,0,5"/>
      <TextBox x:Name="ModelName" Style="{StaticResource Field}" AutomationProperties.Name="模型名称"/>
      <Label Target="{Binding ElementName=KeyBox}" Content="API Key" Padding="0,12,0,5"/>
      <PasswordBox x:Name="KeyBox" Style="{StaticResource Field}" AutomationProperties.Name="API Key"/>
      <TextBlock Text="密钥由当前 Windows 账户加密保存。无需密钥的本地服务可留空。" Style="{StaticResource Hint}" Margin="0,4,0,15"/>
      <Separator Margin="0,0,0,13"/>
      <CheckBox x:Name="EnableChip" Content="鼠标划词后，在选中文字旁显示小蓝点" FontSize="13"/>
      <TextBlock Text="点击蓝点即可在原文旁查看译文。" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
      <TextBlock x:Name="SettingsError" TextWrapping="Wrap" Foreground="#A13726" Margin="0,8,0,0" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,17,0,0">
        <Button Content="取消" IsCancel="True" MinWidth="68" Margin="0,0,8,0"/>
        <Button x:Name="Save" Content="保存设置" IsDefault="True" Style="{StaticResource Primary}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
